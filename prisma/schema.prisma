// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum Attend {
  PRESENT
  ABSENT
  LEAVE
}

model User {
  id         String       @id @default(cuid())
  email      String       @unique
  phone      String?
  phone2     String?
  password   String
  name       String
  role       Role
  student    Student?
  teacher    Teacher?
  attendance Attendance[]
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fatherName      String?
  Adress          String?
  studentSubjects StudentSubject[]
  progress        Progress[]
  enrollments     StudentEnrollment[]
}

model StudentSubject {
  id        String @id @default(cuid())
  studentId String
  subjectId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // One student-subject has one tracked TOC completion
  tocCompletion TocCompletion?

  @@unique([studentId, subjectId])
  @@index([subjectId])
}

model Teacher {
  id              String              @id @default(cuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments     TeacherAssignment[]
  teacherSubjects TeacherSubject[]
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
  @@index([subjectId])
}

model Branch {
  id      String  @id @default(cuid())
  name    String  @unique
  batches Batch[]
}

model Batch {
  id       String @id @default(cuid())
  name     String
  branchId String

  branch   Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  holiday  Holiday[]
  subjects BatchSubject[]
  students StudentEnrollment[]
  teachers TeacherAssignment[]

  @@unique([branchId, name])
}

model BatchSubject {
  id        String @id @default(cuid())
  batchId   String
  subjectId String

  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([batchId, subjectId])
}

model StudentEnrollment {
  id        String @id @default(cuid())
  studentId String
  batchId   String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([batchId])
}

model TeacherAssignment {
  id        String @id @default(cuid())
  teacherId String
  batchId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([teacherId, batchId])
  @@index([batchId])
}

model Holiday {
  id      String   @id @default(cuid())
  batchId String?
  date    DateTime

  batch Batch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, date])
  @@index([batchId, date])
}

model Attendance {
  id        String   @id @default(cuid())
  userId    String
  attended  Attend
  remarks   String?
  batchId   String?
  batchname String
  date      DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, batchId])
  @@index([batchId])
  @@index([userId, date])
}

model Progress {
  id        String   @id @default(cuid())
  studentId String
  batchId   String?
  batchname String
  date      DateTime @db.Date
  remarks   String?
  learnings Json?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, date, batchId])
  @@index([batchId, date])
}

model Subject {
  id              String                  @id @default(cuid())
  name            String
  parts           SubjectPart[]
  batches         BatchSubject[]
  studentSubjects StudentSubject[]
  teacherSubjects TeacherSubject[]
  tocItems        SubjectTocItem[]
  trackingTerms   SubjectTrackingTerm[]
}

model SubjectPart {
  id        String @id @default(cuid())
  name      String
  position  Int
  subjectId String

  subject  Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tocItems SubjectTocItem[]

  @@unique([subjectId, position])
}

model SubjectTocItem {
  id            String  @id @default(cuid())
  subjectId     String
  subjectPartId String
  parentId      String?
  name          String
  position      Int

  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectPart SubjectPart    @relation(fields: [subjectPartId], references: [id], onDelete: Cascade)
  parent      SubjectTocItem? @relation("SubjectTocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    SubjectTocItem[] @relation("SubjectTocTree")

  leafTracks TocLeafTrack[]

  @@unique([parentId, position])
  @@index([subjectId, subjectPartId, parentId])
}

model SubjectTrackingTerm {
  id        String @id @default(cuid())
  subjectId String
  name      String
  position  Int

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, name])
  @@unique([subjectId, position])
  @@index([subjectId])
}

model TocCompletion {
  id               String @id @default(cuid())
  studentSubjectId String @unique

  studentSubject StudentSubject @relation(fields: [studentSubjectId], references: [id], onDelete: Cascade)

  leafTracks TocLeafTrack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TocLeafTrack {
  id              String @id @default(cuid())
  tocCompletionId String
  tocItemId       String
  completedAt     DateTime @db.Date

  tocCompletion TocCompletion @relation(fields: [tocCompletionId], references: [id], onDelete: Cascade)
  tocItem       SubjectTocItem @relation(fields: [tocItemId], references: [id], onDelete: Cascade)

  @@unique([tocCompletionId, tocItemId])
  @@index([tocItemId])
  @@index([tocCompletionId])
  @@index([completedAt])
}